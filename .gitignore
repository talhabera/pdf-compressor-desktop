node_modules/

# Build output
dist/
out/
release/
.vite/
*.tsbuildinfo

# NOTE: `build/` is NOT ignored. electron-builder uses it as buildResources,
# and build/installer.nsh — which installs the VC++ runtime Ghostscript needs
# on Windows — lives there. Ignoring it silently removes that step on a fresh
# clone and reintroduces an app that fails on every PDF.

# Bundled Ghostscript binaries — produced by scripts/fetch-ghostscript.sh,
# far too large for git. See README for the one-time setup step.
resources/gs/

# Ghostscript build scratch
.gs-build/

.DS_Store
*.log
.env
.env.local

# Generated by scripts/make-fixtures.mjs
tests/fixtures/

# Engineering ledger and agent reports from the build process. Not secret,
# just noise for anyone reading the project; kept local by default.
.superpowers/
.remember/
